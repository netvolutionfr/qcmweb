# Copier vers .env et remplacer les valeurs. Le fichier .env n'est jamais commité.
#
#   cp .env.example .env
#   POSTGRES_PASSWORD=$(openssl rand -base64 24) ; sed -i '' "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$POSTGRES_PASSWORD|" .env

POSTGRES_USER=qcmweb
POSTGRES_PASSWORD=remplacer-par-une-valeur-aleatoire
POSTGRES_DB=qcmweb

# Port hôte. 5432 et 5433 sont souvent déjà pris par d'autres projets.
POSTGRES_PORT=5434

# Doit rester cohérent avec les quatre valeurs ci-dessus.
DATABASE_URL=postgres://qcmweb:remplacer-par-une-valeur-aleatoire@localhost:5434/qcmweb

BIND_ADDR=0.0.0.0:3000

# Identifiants de l'unique enseignant de l'instance.
# Le mot de passe est fixé : ni inscription, ni réinitialisation en libre-service.
# Générer l'empreinte avec :  cd api && cargo run -- hash-password
#
# Les apostrophes simples sont obligatoires : une empreinte PHC contient des
# `$` que dotenvy interpréterait sinon comme des références de variables, ce
# qui produit un hash tronqué et un refus de connexion peu explicite.
TEACHER_USERNAME=enseignant
TEACHER_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$remplacer$par-une-vraie-empreinte'
RUST_LOG=info,qcmweb_api=debug,tower_http=debug
